@model AddSettingVersionViewModel
@{
    ViewData["Title"] = "New Setting Version";
}
<div class="page-intro"><div><a class="back-link" asp-action="History" asp-route-id="@Model.SettingDefinitionId">@L["← Setting history"]</a><span class="eyebrow">@L["VERSIONED CHANGE"]</span><h1>@L[Model.SettingName]</h1></div></div>
<section class="panel form-panel narrow"><form asp-action="AddVersion" method="post" class="form-stack"><input asp-for="SettingDefinitionId" type="hidden"/><input asp-for="SettingName" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Value">@L["Value"]</label><input asp-for="Value" autofocus/></div><div class="field"><label asp-for="EffectiveFrom">@L["Effective from"]</label><input asp-for="EffectiveFrom"/></div><div class="field"><label asp-for="ChangeReason">@L["Reason for change"]</label><textarea asp-for="ChangeReason" rows="4" placeholder="@L["Why is this setting changing?"]"></textarea></div><div class="warning-note"><strong>@L["History is preserved."]</strong><span>@L["The previous setting version will be closed automatically."]</span></div><button class="btn primary" type="submit">@L["Create setting version"]</button></form></section>
