@model AddSettingVersionViewModel
@{
    ViewData["Title"] = "New Setting Version";
}
<div class="page-intro"><div><a class="back-link" asp-action="History" asp-route-id="@Model.SettingDefinitionId">← Setting history</a><span class="eyebrow">VERSIONED CHANGE</span><h1>@Model.SettingName</h1></div></div>
<section class="panel form-panel narrow"><form asp-action="AddVersion" method="post" class="form-stack"><input asp-for="SettingDefinitionId" type="hidden"/><input asp-for="SettingName" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Value"></label><input asp-for="Value" autofocus/></div><div class="field"><label asp-for="EffectiveFrom"></label><input asp-for="EffectiveFrom"/></div><div class="field"><label asp-for="ChangeReason"></label><textarea asp-for="ChangeReason" rows="4" placeholder="Why is this setting changing?"></textarea></div><div class="warning-note"><strong>History is preserved.</strong><span>The previous setting version will be closed automatically.</span></div><button class="btn primary" type="submit">Create setting version</button></form></section>
