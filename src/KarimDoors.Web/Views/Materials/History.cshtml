@model MaterialHistory
@{
    ViewData["Title"] = "Material History";
}
<div class="page-intro">
    <div><a class="back-link" asp-action="Index">@L["← Materials"]</a><span class="eyebrow">@Model.Code</span><h1>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? Model.NameAr : Model.NameEn)</h1><p class="arabic lead-ar">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? Model.NameEn : Model.NameAr)</p></div>
    <a class="btn primary" asp-action="AddPrice" asp-route-id="@Model.Id">@L["New price version"]</a>
</div>

<div class="two-column-grid history-grid">
    <section class="panel">
        <div class="panel-heading"><div><span class="eyebrow">@L["Timeline"]</span><h2>@L["Price versions"]</h2></div><span class="badge">@Model.Prices.Count @L["Versions"]</span></div>
        <div class="timeline">
        @foreach (var price in Model.Prices)
        {
            <article class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-card">
                    <div class="timeline-head"><div><strong>@price.UnitPrice.ToString("N2") @price.Currency</strong><small>@L["Version"] @price.Version</small></div>@if(price.EffectiveToUtc is null){<span class="badge success">@L["Current"]</span>}</div>
                    <div class="date-range">@price.EffectiveFromUtc.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture) → @(price.EffectiveToUtc?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture) ?? L["Current"].Value)</div>
                    <p>@L[price.ChangeReason ?? "No reason recorded"]</p>
                    @if (!string.IsNullOrWhiteSpace(price.SupplierReference)) { <small>@L["Reference"]: @price.SupplierReference</small> }
                </div>
            </article>
        }
        </div>
    </section>
    <aside class="panel sticky-panel">
        <span class="eyebrow">@L["Material profile"]</span>
        <h2>@Model.Code</h2>
        <div class="summary-lines compact">
            <div><span>@L["Category"]</span><strong>@L[Model.Category.ToString()]</strong></div>
            <div><span>@L["Pricing unit"]</span><strong>@L[Model.Unit.ToString()]</strong></div>
            <div><span>@L["Versions"]</span><strong>@Model.Prices.Count</strong></div>
        </div>
        <div class="info-note"><strong>@L["Why versions?"]</strong><p>@L["Old quotations keep resolving to the price that was effective on their calculation date."]</p></div>
    </aside>
</div>
