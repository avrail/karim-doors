@model AddMaterialPriceViewModel
@{
    ViewData["Title"] = "New Material Price";
}
<div class="page-intro"><div><a class="back-link" asp-action="History" asp-route-id="@Model.MaterialId">← Price history</a><span class="eyebrow">VERSIONED CHANGE</span><h1>New price version</h1><p>@Model.MaterialName</p></div></div>
<section class="panel form-panel narrow">
    <form asp-action="AddPrice" method="post" class="form-stack">
        <input asp-for="MaterialId" type="hidden" />
        <input asp-for="MaterialName" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-grid two">
            <div class="field"><label asp-for="UnitPrice"></label><input asp-for="UnitPrice" autofocus /></div>
            <div class="field"><label asp-for="Currency"></label><input asp-for="Currency" /></div>
        </div>
        <div class="field"><label asp-for="EffectiveFrom"></label><input asp-for="EffectiveFrom" /><small>The current price will automatically end at this date.</small></div>
        <div class="field"><label asp-for="SupplierReference"></label><input asp-for="SupplierReference" placeholder="Supplier quote / PO / email reference" /></div>
        <div class="field"><label asp-for="ChangeReason"></label><textarea asp-for="ChangeReason" rows="4" placeholder="Why is this price changing?"></textarea></div>
        <div class="warning-note"><strong>History is immutable.</strong><span>This creates a new version; it does not overwrite the previous price.</span></div>
        <button class="btn primary" type="submit">Create price version</button>
    </form>
</section>
