@model QuotationDraftViewModel
@{ ViewData["Title"] = "New quotation"; }
<div class="page-intro"><div><span class="eyebrow">@L["Quotations"]</span><h1>@L["New quotation"]</h1></div></div>
@if (Model.ErrorMessage is not null) { <div class="alert danger">@Model.ErrorMessage</div> }
<section class="panel" style="padding:1.5rem">
<form asp-action="Create" method="post" class="form-stack">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <div class="form-grid two">
        <div class="field"><label asp-for="CustomerName">@L["Customer"]</label><input asp-for="CustomerName" maxlength="200" /></div>
        <div class="field"><label asp-for="ProjectName">@L["Project"]</label><input asp-for="ProjectName" maxlength="200" /></div>
    </div>
    <h2>@L["Door items"]</h2>
    <div id="quote-lines">
    @for (var i = 0; i < Model.Lines.Count; i++)
    {
        <div class="form-grid two quote-line">
            <div class="field"><label>@L["Door template"] <span class="line-number">@(i + 1)</span></label>
                <select asp-for="Lines[i].DoorCode">
                    <option value="">@L["Select a door"]</option>
                    @foreach (var door in Model.AvailableDoors)
                    {
                        <option value="@door.Code">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? door.NameAr : door.NameEn) — @door.Width × @door.Height mm</option>
                    }
                </select>
            </div>
            <div class="field"><label>@L["Quantity"]</label><input asp-for="Lines[i].Quantity" type="number" min="0.01" step="0.01" /></div>
        </div>
    }
    </div>
    <button class="btn" type="button" id="add-quote-line">@L["Add another door"]</button>
    <button class="btn primary" type="submit">@L["Save draft quotation"]</button>
</form>
</section>
<script>
document.getElementById('add-quote-line').addEventListener('click', () => {
    const container = document.getElementById('quote-lines');
    const index = container.querySelectorAll('.quote-line').length;
    const row = container.querySelector('.quote-line').cloneNode(true);
    row.querySelector('.line-number').textContent = index + 1;
    row.querySelectorAll('[name]').forEach(input => {
        input.name = input.name.replace(/Lines\[\d+\]/, `Lines[${index}]`);
        input.id = input.id.replace(/Lines_\d+__/, `Lines_${index}__`);
        input.value = input.tagName === 'SELECT' ? '' : '1';
    });
    container.appendChild(row);
});
</script>
