@model PricingCalculatorViewModel
@{
    ViewData["Title"] = "Price Calculator";
}

@section Scripts {
<script>
(() => {
    const project = document.getElementById('ProjectId');
    const door = document.getElementById('DoorTemplateCode');
    const width = document.getElementById('WidthMm');
    const height = document.getElementById('HeightMm');
    const note = document.getElementById('door-size-note');
    function applyDoor(resetSize) {
        const option = door.selectedOptions[0];
        if (!option) return;
        if (resetSize) {
            width.value = option.dataset.width;
            height.value = option.dataset.height;
        }
        const fixed = option.dataset.fixedSize === 'true';
        width.readOnly = fixed;
        height.readOnly = fixed;
        note.hidden = !fixed;
    }
    function filterDoors(resetSize) {
        for (const option of door.options) {
            const matches = option.dataset.projectId === project.value;
            option.hidden = !matches;
            option.disabled = !matches;
        }
        if (resetSize || !door.selectedOptions.length || door.selectedOptions[0].disabled) {
            const first = [...door.options].find(option => !option.disabled);
            if (first) door.value = first.value;
            resetSize = true;
        }
        applyDoor(resetSize);
    }
    project.addEventListener('change', () => filterDoors(true));
    door.addEventListener('change', () => applyDoor(true));
    filterDoors(false);
})();
</script>
}

<div class="page-intro">
    <div><span class="eyebrow">@L["LIVE COSTING"]</span><h1>@L["Door Price Calculator"]</h1><p>@L["Choose a project, then one of its door models. Prices use the selected pricing date."]</p></div>
    <span class="badge">@L["Historical-aware"]</span>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert danger">@Model.ErrorMessage</div>
}

<div class="calculator-layout">
    <section class="panel calculator-form-panel">
        <div class="panel-heading"><div><span class="eyebrow">@L["Input"]</span><h2>@L["Door configuration"]</h2></div><span class="step-chip">01</span></div>
        <form asp-action="Calculator" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field">
                <label asp-for="ProjectId">@L["Project"]</label>
                <select asp-for="ProjectId">
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? project.Code == "RED-2022" ? "ريدكون" : project.Code == "SOURCE-2022" ? "حسن علام" : project.Name : project.Name)</option>
                    }
                </select>
                <span asp-validation-for="ProjectId"></span>
                <small>@L["The project groups the door models from that customer's workbook."]</small>
            </div>

            <div class="field">
                <label asp-for="DoorTemplateCode">@L["Door model"]</label>
                <select asp-for="DoorTemplateCode">
                    @foreach (var item in Model.DoorTemplates)
                    {
                        <option value="@item.Code" data-project-id="@item.ProjectId" data-width="@item.WidthMm" data-height="@item.HeightMm" data-fixed-size="@item.ReferenceSizeOnly.ToString().ToLowerInvariant()">@item.Code · @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? item.NameAr : item.NameEn) · @item.WidthMm × @item.HeightMm mm</option>
                    }
                </select>
                <span asp-validation-for="DoorTemplateCode"></span>
                <small id="door-size-note">@L["Workbook reference models are priced only at their shown dimensions."]</small>
            </div>

            <div class="form-grid two">
                <div class="field"><label asp-for="WidthMm">@L["Width (mm)"]</label><input asp-for="WidthMm" /><span asp-validation-for="WidthMm"></span></div>
                <div class="field"><label asp-for="HeightMm">@L["Height (mm)"]</label><input asp-for="HeightMm" /><span asp-validation-for="HeightMm"></span></div>
            </div>

            <div class="form-grid two">
                <div class="field"><label asp-for="Quantity">@L["Quantity"]</label><input asp-for="Quantity" /><span asp-validation-for="Quantity"></span></div>
                <div class="field"><label asp-for="CalculationDate">@L["Pricing date"]</label><input asp-for="CalculationDate" /><span asp-validation-for="CalculationDate"></span></div>
            </div>

            <button class="btn primary wide" type="submit">@L["Calculate price"] <span>→</span></button>
        </form>
    </section>

    <aside class="price-summary-card @(Model.Result is null ? "is-empty" : string.Empty)">
        @if (Model.Result is null)
        {
            <span class="eyebrow">@L["Result"]</span>
            <h2>@L["Ready to calculate"]</h2>
            <div class="summary-placeholder">
                <div class="mini-door"></div>
                <p>@L["Select a template and dimensions. The engine will use the price versions effective on your pricing date."]</p>
            </div>
        }
        else
        {
            var r = Model.Result;
            <div class="summary-head"><div><span class="eyebrow">@L["Calculated unit price"]</span><h2>@r.DoorTemplateCode</h2></div><span class="badge success">v@r.DoorTemplateVersion</span></div>
            <div class="price-number"><strong>@r.UnitCalculatedPrice.ToString("N2")</strong><span>@r.Currency</span></div>
            <div class="dimension-line">@r.WidthMm × @r.HeightMm mm · @(r.FireRatingMinutes == 0 ? L["Non-fire"].Value : $"FD{r.FireRatingMinutes}")</div>

            <div class="summary-lines">
                <div><span>@L["Materials"]</span><strong>@r.MaterialCost.ToString("N2")</strong></div>
                <div><span>@L["Manufacturing"]</span><strong>@r.ManufacturingCost.ToString("N2")</strong></div>
                <div><span>@L["Transport"]</span><strong>@r.TransportCost.ToString("N2")</strong></div>
                <div><span>@L["Installation"]</span><strong>@r.InstallationCost.ToString("N2")</strong></div>
                <div class="subtotal"><span>@L["Dry cost"]</span><strong>@r.DryCost.ToString("N2")</strong></div>
                <div><span>@L["Administrative"] (@r.AdministrativePercentage.ToString("0.##")%)</span><strong>@r.AdministrativeCost.ToString("N2")</strong></div>
                <div><span>@L["Profit"] (@r.ProfitPercentage.ToString("0.##")%)</span><strong>@r.ProfitCost.ToString("N2")</strong></div>
            </div>
            @if (r.Quantity != 1)
            {
                <div class="grand-total"><span>@L["Total"] × @r.Quantity.ToString("N2")</span><strong>@r.TotalCalculatedPrice.ToString("N2") @r.Currency</strong></div>
            }
            <small class="summary-foot">@L["Profile"] @r.PricingProfileCode v@r.PricingProfileVersion · @r.CalculationDateUtc.ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentUICulture)</small>
        }
    </aside>
</div>

@if (Model.Result is not null)
{
    <section class="panel breakdown-panel">
        <div class="panel-heading"><div><span class="eyebrow">@L["Traceability"]</span><h2>@L["Cost breakdown"]</h2><p>@L["Every row records the material price version used by the calculation."]</p></div><span class="badge">@Model.Result.Components.Count @L["items"]</span></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>@L["Component"]</th><th>@L["Material"]</th><th class="num">@L["Measurement"]</th><th class="num">@L["Unit price"]</th><th class="num">@L["Waste"]</th><th class="num">@L["Cost"]</th><th>@L["Price version"]</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Result.Components)
                {
                    <tr>
                        <td><strong>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? item.NameAr : item.NameEn)</strong><small class="arabic">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? item.NameEn : item.NameAr)</small></td>
                        <td><code>@item.MaterialCode</code></td>
                        <td class="num">@item.Measurement.ToString("N4") <small>@item.Unit</small></td>
                        <td class="num">@item.UnitPrice.ToString("N2")</td>
                        <td class="num">@item.WastePercentage.ToString("0.##")%</td>
                        <td class="num"><strong>@item.TotalCost.ToString("N2")</strong></td>
                        <td><span class="version-pill">v@item.MaterialPriceVersion</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
