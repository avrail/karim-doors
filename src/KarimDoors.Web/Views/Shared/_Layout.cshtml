<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "rtl" : "ltr")" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L[ViewData["Title"]?.ToString() ?? "Karim Doors"] · @L["Karim Doors"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Kufi+Arabic:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">KD</span>
                <span class="brand-copy">
                    <strong>@L["Karim Doors"]</strong>
                    <small>@L["Pricing Intelligence"]</small>
                </span>
            </a>

            <nav class="nav-stack">
                <span class="nav-caption">@L["Workspace"]</span>
                <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><span>⌂</span> @L["Dashboard"]</a>
                <a class="nav-link @Active("Pricing")" asp-controller="Pricing" asp-action="Calculator"><span>◇</span> @L["Price Calculator"]</a>
                <a class="nav-link @Active("Quotations")" asp-controller="Quotations" asp-action="Index"><span>▤</span> @L["Quotations"]</a>
                <span class="nav-caption">@L["Master data"]</span>
                <a class="nav-link @Active("Doors")" asp-controller="Doors" asp-action="Index"><span>▥</span> @L["Door catalog"]</a>
                <a class="nav-link @Active("Materials")" asp-controller="Materials" asp-action="Index"><span>▦</span> @L["Materials & Prices"]</a>
                <a class="nav-link @Active("Settings")" asp-controller="Settings" asp-action="Index"><span>⚙</span> @L["System Settings"]</a>
                <span class="nav-caption">@L["Control"]</span>
                <a class="nav-link @Active("Audit")" asp-controller="Audit" asp-action="Index"><span>↺</span> @L["Audit Log"]</a>
            </nav>

            <div class="sidebar-note">
                <span class="status-dot"></span>
                <div><strong>@L["History protected"]</strong><small>@L["Changes create new versions."]</small></div>
            </div>
        </aside>

        <div class="main-column">
            <header class="topbar">
                <button class="icon-button mobile-only" id="menuToggle" type="button" aria-label="@L["Toggle navigation"]">☰</button>
                <div>
                    <div class="eyebrow">@L["Door Cost Management"]</div>
                <div class="topbar-title">@L[ViewData["Title"]?.ToString() ?? "Karim Doors"]</div>
                </div>
            <div class="topbar-actions">
                <a class="language-switch" asp-controller="Language" asp-action="Set" asp-route-culture="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en-US" : "ar-EG")" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" lang="@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "en" : "ar")">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "English" : "العربية")</a>
                    <span class="environment-pill">@L["Development"]</span>
                <button class="icon-button" id="themeToggle" type="button" aria-label="@L["Toggle theme"]">◐</button>
                </div>
            </header>

            <main class="content-wrap">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert success">@L[success]</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    string Active(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
